# =============================================================================
# Cortexa AI Agent Platform — environment variable contract
# =============================================================================
# Copy to `.env` for local use:
#   cp .env.example .env
# Never commit real secrets. `.env` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Cortexa AI Agent Platform
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortexa_agent
POSTGRES_USER=cortexa
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql+asyncpg://cortexa:local_development_only@postgres:5432/cortexa_agent

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Ollama / LLM (Phase 2)
# -----------------------------------------------------------------------------
# Inside Compose, backend MUST use the service DNS name (not localhost:11435).
LLM_PROVIDER=ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_HOST_PORT=11435
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_INPUT_CHARACTERS=32000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_DEFAULT_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Security placeholders (NOT implemented in Phase 2)
# -----------------------------------------------------------------------------
CORTEXA_SECRET_KEY=change_me_to_a_long_random_string
CORTEXA_SESSION_HTTPS_ONLY=false

# -----------------------------------------------------------------------------
# Future-phase placeholders (NOT wired in Phase 2)
# -----------------------------------------------------------------------------
CORTEXA_CHAT_MODEL=qwen2.5:7b
CORTEXA_FALLBACK_CHAT_MODEL=llama3.1:8b
CORTEXA_EMBEDDING_MODEL=nomic-embed-text
CORTEXA_STT_PROVIDER=local
CORTEXA_TTS_PROVIDER=local
