# =============================================================================
# Cortexa AI Agent Platform — environment variable contract
# =============================================================================
# Copy to `.env` for local use:
#   cp .env.example .env
# Never commit real secrets. `.env` is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Cortexa AI Agent Platform
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cortexa_agent
POSTGRES_USER=cortexa
POSTGRES_PASSWORD=local_development_only
DATABASE_URL=postgresql+asyncpg://cortexa:local_development_only@postgres:5432/cortexa_agent
# Durable identity — readiness fails if the connected DB does not match.
EXPECTED_APPLICATION_ID=cortexa-ai-agent-platform
EXPECTED_DATABASE_IDENTITY=cortexa-agent-development
DATABASE_IDENTITY_CHECK_ENABLED=true
# Compose project/volume identity (also enforced by scripts/check_compose_identity.sh)
COMPOSE_PROJECT_NAME=cortexa
# Automated tests use docker-compose.test.yml with -p cortexa-test:
#   POSTGRES_DB=cortexa_agent_test
#   EXPECTED_DATABASE_IDENTITY=cortexa-agent-test
#   volume cortexa_postgres_test_data / redis-test
# Never point this development .env at the test database.

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# CORS / frontend origin (comma-separated origins; credentials require explicit origins)
# -----------------------------------------------------------------------------
# CRITICAL: Do NOT mix localhost and 127.0.0.1 between the browser URL and the
# API base URL. SameSite=Lax refresh cookies are host-bound; a mismatch makes
# login succeed (access token in memory) but page reload show "Not signed in".
# Pick ONE host and use it for FRONTEND_ORIGIN, NEXT_PUBLIC_API_BASE_URL,
# PASSWORD_RESET_FRONTEND_URL, and the URL you open in the browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:13000,http://127.0.0.1:13000
FRONTEND_ORIGIN=http://127.0.0.1:13000

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Must use the same hostname as the browser (see CORS note above).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:18000
FRONTEND_PORT=13000

# -----------------------------------------------------------------------------
# Authentication (Phase 3)
# REPLACE JWT_SECRET_KEY before any non-local deployment.
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=REPLACE_ME_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_COOKIE_NAME=cortexa_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# -----------------------------------------------------------------------------
# Password reset (Phase 5.1)
# Development delivery does NOT send real email. Use the CLI to retrieve links.
# -----------------------------------------------------------------------------
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_BYTES=32
PASSWORD_RESET_MAX_ACTIVE_TOKENS=3
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
PASSWORD_RESET_FRONTEND_URL=http://127.0.0.1:13000/reset-password
PASSWORD_RESET_DELIVERY_PROVIDER=development
PASSWORD_RESET_DEV_EXPOSE_TOKEN=false
# Show local-dev notice on /forgot-password (must be false in production)
PASSWORD_RESET_DEV_NOTICE_ENABLED=true
# Frontend public flag (must match backend notice policy for local UX)
NEXT_PUBLIC_PASSWORD_RESET_DEV_NOTICE=true
# Optional privacy-hash secrets for IP / User-Agent metadata (falls back to JWT secret)
# PASSWORD_RESET_IP_HASH_SECRET=
# PASSWORD_RESET_USER_AGENT_HASH_SECRET=
# Legacy DB recovery CLI override (keep false unless deliberately recovering in prod)
LEGACY_DB_MIGRATION_ALLOW_PRODUCTION=false
# Local user create/reset CLI — keep false; only override for emergency admin recovery.
ADMIN_USER_CLI_ALLOW_PRODUCTION=false

# Phase 8 — Enterprise admin portal uses UserRole.admin.
# Create a development admin with:
#   docker compose exec backend python -m app.cli.create_user \
#     --email admin@example.com --name "Platform Administrator" --role admin
# Admin UI: http://127.0.0.1:13000/admin
# Unsafe settings (JWT, DB URLs, secrets) are never editable via the admin API.

# -----------------------------------------------------------------------------
# Ollama / LLM (Phase 2)
# -----------------------------------------------------------------------------
# Inside Compose, backend MUST use the service DNS name (not localhost:11435).
LLM_PROVIDER=ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_HOST_PORT=11435
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
# Keep the chat model loaded between requests (Ollama keep_alive).
OLLAMA_KEEP_ALIVE=10m
# Optional chat generation caps (unset = use LLM_MAX_OUTPUT_TOKENS / model default).
# OLLAMA_CHAT_NUM_PREDICT=512
# OLLAMA_CHAT_NUM_CTX=4096
OLLAMA_FIRST_TOKEN_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARACTERS=32000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_DEFAULT_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Documents / storage (Phase 4)
# -----------------------------------------------------------------------------
DOCUMENT_UPLOAD_ENABLED=true
DOCUMENT_STORAGE_PATH=/var/lib/cortexa/documents
DOCUMENT_MAX_FILE_SIZE_BYTES=5242880
DOCUMENT_ALLOWED_EXTENSIONS=.txt,.md,.pdf,.docx
DOCUMENT_MAX_TEXT_CHARACTERS=500000
DOCUMENT_MAX_CHUNKS=500

# -----------------------------------------------------------------------------
# Chunking (Phase 4)
# -----------------------------------------------------------------------------
CHUNK_SIZE_CHARACTERS=1200
CHUNK_OVERLAP_CHARACTERS=200
CHUNK_MIN_CHARACTERS=40

# -----------------------------------------------------------------------------
# Embeddings (Phase 4)
# Pull explicitly: docker compose exec ollama ollama pull nomic-embed-text
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
EMBEDDING_MAX_INPUT_CHARACTERS=8000

# -----------------------------------------------------------------------------
# RAG retrieval / generation (Phase 4)
# -----------------------------------------------------------------------------
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MIN_SIMILARITY=0.4
RAG_MAX_QUERY_CHARACTERS=2000
RAG_MAX_CONTEXT_CHARACTERS=12000
RAG_CITATION_EXCERPT_CHARACTERS=280

# -----------------------------------------------------------------------------
# Conversations / multi-turn chat (Phase 5)
# Memory is scoped to a single conversation — no cross-conversation or profile memory.
# -----------------------------------------------------------------------------
CONVERSATION_MAX_HISTORY_MESSAGES=20
CONVERSATION_MAX_HISTORY_CHARACTERS=16000
CONVERSATION_MAX_CONTEXT_CHARACTERS=24000
CONVERSATION_SUMMARY_TRIGGER_MESSAGES=12
CONVERSATION_SUMMARY_MAX_CHARACTERS=1500
CONVERSATION_TITLE_MAX_CHARACTERS=80
MESSAGE_MAX_CHARACTERS=8000
MESSAGE_MAX_RESPONSE_TOKENS=2048
CHAT_DEFAULT_TEMPERATURE=0.4
CHAT_DEFAULT_TOP_K=5
CONVERSATION_SEARCH_MAX_RESULTS=25
CONVERSATION_LIST_DEFAULT_LIMIT=20
CONVERSATION_LIST_MAX_LIMIT=50
CITATION_EXCERPT_MAX_CHARACTERS=280
CONVERSATION_AUTO_TITLE_ENABLED=true
CONVERSATION_SUMMARY_ENABLED=true
CHAT_GENERAL_MODE_ENABLED=true

# -----------------------------------------------------------------------------
# Agent tools / function calling (Phase 6)
# Native Ollama tool calling depends on the installed model. Tests use a
# deterministic fake provider. Do not assume live tool calling without verifying
# your model supports Ollama tools.
# -----------------------------------------------------------------------------
AGENT_TOOLS_ENABLED=true
AGENT_MAX_TOOL_ITERATIONS=3
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_RESULT_BYTES=32768

# -----------------------------------------------------------------------------
# Long-term memory / personalization (Phase 7)
# Automatic extraction stays OFF by default. Users must opt in explicitly.
# Confirmation is required by default for non-explicit saves.
# -----------------------------------------------------------------------------
MEMORY_ENABLED=true
MEMORY_AUTOMATIC_EXTRACTION_DEFAULT=false
MEMORY_SUGGESTIONS_DEFAULT=true
MEMORY_REQUIRE_CONFIRMATION_DEFAULT=true
MEMORY_MAX_ACTIVE_PER_USER=100
MEMORY_MAX_RETRIEVAL_RESULTS=5
MEMORY_MAX_CONTENT_CHARACTERS=2000
MEMORY_TITLE_MAX_CHARACTERS=200
MEMORY_CONTEXT_MAX_CHARACTERS=3000
MEMORY_DEFAULT_EXPIRATION_DAYS=
MEMORY_MIN_RELEVANCE_SCORE=0.35
MEMORY_DUPLICATE_SIMILARITY_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# Future-phase placeholders (NOT wired in Phase 7)
# -----------------------------------------------------------------------------
CORTEXA_CHAT_MODEL=qwen2.5:7b
CORTEXA_FALLBACK_CHAT_MODEL=llama3.1:8b
CORTEXA_EMBEDDING_MODEL=nomic-embed-text
CORTEXA_STT_PROVIDER=local
CORTEXA_TTS_PROVIDER=local
